  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Target list rows drive per-video and per-post comment collection",
        "Raw CSV is deduped and merged with topic/content metadata by title",
        "Each comment is event-filtered, sentiment-split, then labeled",
        "Labeled rows, crosstabs, and wordclouds land in results/ and figures/"
      ]
    },
    {
      "dot": "amber",
      "title": "Routing inside the pipeline",
      "items": [
        "Event keyword match short-circuits analysis — no model call",
        "Negative comments: one Gemini call each for is_complaint / type / summary",
        "Positive comments: Kiwi top-80 keywords, one Gemini call, priority keyword match",
        "Gemini wrapper retries 429/503 three times and sleeps ~4.5s per call"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries and secrets",
      "items": [
        "All compute is local; only the loopback dashboard server listens (127.0.0.1:8765)",
        "GEMINI_API_KEY, YOUTUBE_API_KEY, INSTA_USERNAME/PASSWORD load from .env or environment",
        "Instagram session cookies are cached to insta_session.json on disk",
        "Comment text and author names leave the machine only toward Gemini"
      ]
    },
    {
      "dot": "emerald",
      "title": "Supporting runtime detail",
      "items": [
        "Hugging Face Hub login is optional (HUGGINGFACE_TOKEN) for model download",
        "Torch device auto-selects MPS on Apple Silicon, else CPU",
        "Collectors checkpoint to CSV every 5 videos / 3 posts; Instagram sleeps 15-30s per post",
        "regression.py reads michuhol_analysis_raw.csv, writes 7 result CSVs and 2 figures"
      ]
    }
  ]
